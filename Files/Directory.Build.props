<Project>
	<ItemGroup Label="Entity Files" Condition="'$(PkgPath)' != ''">
		<Compile Include="$(PkgPath)/UsrBusinessTrip/Schemas/Activity/Activity.cs" Condition="Exists('$(PkgPath)/UsrBusinessTrip/Schemas/Activity/Activity.cs')" />
